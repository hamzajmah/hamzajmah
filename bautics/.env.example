# --- Bautics Konfiguration (Kopie als .env ablegen, niemals committen) ---

# Modellzugriff laeuft ausschliesslich ueber OpenRouter
# (OpenAI-kompatibel, https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# Modellwahl je Use Case - nach aussen heisst das immer nur "Bautics Engine"
BAUTICS_MODEL_ECHO=anthropic/claude-sonnet-5
BAUTICS_MODEL_MIND=anthropic/claude-sonnet-5
BAUTICS_MODEL_EMBEDDING=qwen/qwen3-embedding-8b
# Muss zur Vektorlaenge des Embedding-Modells passen (pgvector-Spaltenbreite)
BAUTICS_EMBEDDING_DIMENSIONEN=4096

# Spracherkennung (eigener Provider, laeuft nicht ueber OpenRouter):
# "openai" (Whisper API) oder "deepgram"
BAUTICS_STT_PROVIDER=openai
OPENAI_API_KEY=
DEEPGRAM_API_KEY=

# Twilio WhatsApp (Sandbox: https://console.twilio.com -> Messaging -> Try it out)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Nur fuer lokale Tests auf "false" setzen - in Produktion immer pruefen
BAUTICS_TWILIO_SIGNATUR_PRUEFEN=true

# Oeffentliche Basis-URL dieses Servers (fuer Twilio-Signatur und PDF-Links)
BAUTICS_BASE_URL=http://localhost:8000

# Datenbank (Demo: SQLite; Produktion: Postgres-URL)
BAUTICS_DATABASE_URL=sqlite:///./data/bautics.db

# Ablage fuer Audio/PDFs
BAUTICS_STORAGE_DIR=./data/storage

# Wissensbank-Ordner fuer Mind. Ein Unterordner je Baulos:
#   wissensbank/SuedLink Baulos 4/LV_Los4.pdf
BAUTICS_KNOWLEDGE_DIR=./data/wissensbank

# Mind: Zerlegung und Suche (Standardwerte reichen normalerweise)
BAUTICS_MIND_CHUNK_MAX=1400
BAUTICS_MIND_CHUNK_UEBERLAPPUNG=200
BAUTICS_MIND_BELEGE=8
# Untergrenze der Kosinus-Aehnlichkeit; darunter wird nicht geantwortet
BAUTICS_MIND_MIN_AEHNLICHKEIT=0.30

# Zugangstoken fuer die /mind-Routen (Bearer) UND fuer die Anmeldung an der
# Oberflaeche. In Produktion Pflicht - die Wissensbank enthaelt Kundendokumente.
# Ohne Token laeuft beides ungeschuetzt; die Oberflaeche zeigt dann ein Warnband
# und bietet gar kein Anmeldeformular an.
BAUTICS_API_TOKEN=

# Oberflaeche: Laufzeit der Sitzung nach der Token-Eingabe (Stunden) und
# Bremse gegen das Durchprobieren des Tokens am Anmeldeformular.
BAUTICS_UI_SITZUNG_STUNDEN=12
BAUTICS_UI_ANMELDE_VERSUCHE=10
BAUTICS_UI_ANMELDE_SPERRE=300

# Zuordnung Absender -> Baulos (JSON), sonst greift der Standard
BAUTICS_PROJEKT_ZUORDNUNG={}
BAUTICS_PROJEKT_STANDARD=Unbekanntes Baulos
