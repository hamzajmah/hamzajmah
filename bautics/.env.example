# --- Bautics Konfiguration (Kopie als .env ablegen, niemals committen) ---

# Anthropic (Claude) - https://console.anthropic.com
ANTHROPIC_API_KEY=

# Modelle: Kundensichtbares -> Opus, Fleissarbeit -> Haiku
BAUTICS_MODEL_REPORT=claude-opus-5
BAUTICS_MODEL_FAST=claude-haiku-4-5

# Spracherkennung: "openai" (Whisper API) oder "deepgram"
BAUTICS_STT_PROVIDER=openai
OPENAI_API_KEY=
DEEPGRAM_API_KEY=

# Twilio WhatsApp (Sandbox: https://console.twilio.com -> Messaging -> Try it out)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Oeffentliche Basis-URL dieses Servers (fuer PDF-Links in WhatsApp)
BAUTICS_BASE_URL=http://localhost:8000

# Datenbank (Demo: SQLite; Produktion: Postgres-URL)
BAUTICS_DATABASE_URL=sqlite:///./data/bautics.db

# Ablage fuer Audio/PDFs
BAUTICS_STORAGE_DIR=./data/storage

# Wissensbank-Ordner (PDFs fuer die Demo)
BAUTICS_KNOWLEDGE_DIR=./data/wissensbank
