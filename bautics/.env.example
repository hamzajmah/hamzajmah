# --- Bautics Konfiguration (Kopie als .env ablegen, niemals committen) ---

# Modellzugriff laeuft ausschliesslich ueber OpenRouter
# (OpenAI-kompatibel, https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# Modellwahl je Use Case - nach aussen heisst das immer nur "Bautics Engine"
BAUTICS_MODEL_ECHO=anthropic/claude-sonnet-5

# Spracherkennung (eigener Provider, laeuft nicht ueber OpenRouter):
# "openai" (Whisper API) oder "deepgram"
BAUTICS_STT_PROVIDER=openai
OPENAI_API_KEY=
DEEPGRAM_API_KEY=

# Twilio WhatsApp (Sandbox: https://console.twilio.com -> Messaging -> Try it out)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Nur fuer lokale Tests auf "false" setzen - in Produktion immer pruefen
BAUTICS_TWILIO_SIGNATUR_PRUEFEN=true

# Oeffentliche Basis-URL dieses Servers (fuer Twilio-Signatur und PDF-Links)
BAUTICS_BASE_URL=http://localhost:8000

# Datenbank (Demo: SQLite; Produktion: Postgres-URL)
BAUTICS_DATABASE_URL=sqlite:///./data/bautics.db

# Ablage fuer Audio/PDFs
BAUTICS_STORAGE_DIR=./data/storage

# Wissensbank-Ordner (PDFs fuer die Demo)
BAUTICS_KNOWLEDGE_DIR=./data/wissensbank

# Zuordnung Absender -> Baulos (JSON), sonst greift der Standard
BAUTICS_PROJEKT_ZUORDNUNG={}
BAUTICS_PROJEKT_STANDARD=Unbekanntes Baulos
